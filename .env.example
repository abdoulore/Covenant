# Copy to .env and fill. Never commit .env.
# Testnet only. See docs/VERIFICATIONS.md before changing any address.

# ---- Arc testnet (VERIFICATIONS.md V1) ----
# Primary is drpc: Circle's public endpoint rate limits at roughly 22% under sustained load,
# which an event-polling executor will hit constantly. See VERIFICATIONS.md V15 before changing.
ARC_TESTNET_RPC_URL=https://arc-testnet.drpc.org
ARC_TESTNET_RPC_FALLBACK_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://testnet.arcscan.app

# ---- Destination chain RPC (VERIFICATIONS.md V4) ----
BASE_SEPOLIA_RPC_URL=https://base-sepolia.drpc.org
BASE_SEPOLIA_RPC_FALLBACK_URL=https://sepolia.base.org
BASE_SEPOLIA_CHAIN_ID=84532
# USDC only. EURC is deliberately absent: it has no cross-chain route (V3), and leaving it
# unconfigured makes an attempt to pay EURC here fail with a clear message instead of silently.
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ---- Token addresses on Arc testnet (VERIFICATIONS.md V2) ----
# USDC is the 6 decimal ERC-20 view. The 18 decimal native view is gas only, never use it for amounts.
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a

# ---- Pyth oracle (VERIFICATIONS V21) ----
# Pyth's onchain contracts on Arc are keyless. The Oracle condition points at a PythAggregatorV3
# wrapper (the official Pyth adapter, one per feed) deployed with script/DeployPythAggregator.s.sol.
# ARC_PYTH_WRAPPER_USDC is the deploy output; fill it after deploying. Update fee is 1 wei native USDC.
ARC_PYTH_ADDRESS=0x2880aB155794e7179c9eE2e38200202908C17B43
PYTH_USDC_USD_FEED_ID=0xeaa020c61cc479712813461ce153894a96a6c00b21ed0cfc2798d1f9a9e9c94a
ARC_PYTH_WRAPPER_USDC=

# Hermes, Pyth's offchain price service, is NOT keyless any more. The Pyth Core upgrade put every
# instance behind an API key and an unauthenticated request returns 401 with the body
# `unauthorized`. Two things stop working without this key: the depeg panel goes blank, and a
# releaseWithProof cannot be submitted at all, because the API has no signed price to post onchain.
# The other five conditions, and the pushed Oracle condition, are unaffected: they read the chain.
#
# The key is server-side only. It must never reach the landing page or the operator app, which are
# static files anyone can read; the landing page reads the price back from this API for exactly
# that reason. Set PYTH_HERMES_BASE_URL only if your key is issued for another instance, for
# example https://pyth.dourolabs.app/hermes.
PYTH_API_KEY=
PYTH_HERMES_BASE_URL=

# ---- Deployment ----
# PolicyVault is immutable, so each change of shape is a new address and the older deployments keep
# holding live policies. Both are read by the monitor and the app, and BOTH number their policies
# from zero: policy 4 on v2 and policy 4 on v3 are different policies. Every write names its vault
# for that reason. New policies are only ever created on the newest (v3).
DEPLOYER_PRIVATE_KEY=
# v2: the four condition types and the Pyth oracle. Read-only, monitor surface only.
POLICY_VAULT_ADDRESS=
# v3 adds recurring/sweep scheduling. Read-only since the v4 migration.
POLICY_VAULT_V3_ADDRESS=
# v4 is the current deployment and the only writable one: correctness fixes plus the pull-oracle
# path (OraclePull) with the confidence guard. See docs/specs/V4_VAULT.md.
POLICY_VAULT_V4_ADDRESS=

# ---- Operator API and app (npm run api) ----
# The write API refuses to start in a deployed environment without OPERATOR_SECRET and a pinned
# COVENANT_CORS_ORIGIN. That is deliberate: a write-capable API that boots wide open is the failure
# the check exists to prevent. For a local run set COVENANT_ENV=dev, which lets both fall back.
#
# OPERATOR_SECRET is the single operator's password, exchanged for a signed session cookie. Rotating
# it invalidates every outstanding session. Generate one with:  openssl rand -base64 32
OPERATOR_SECRET=
# The one browser origin allowed to call the API with credentials. Never a wildcard: the session
# cookie must travel, and a wildcard with credentials is both invalid and unsafe.
COVENANT_CORS_ORIGIN=
# Set to "dev" for a local run (relaxes the two requirements above, and drops the Secure cookie flag
# so the cookie works over plain HTTP). Leave EMPTY for anything deployed.
COVENANT_ENV=
API_PORT=4320
# Set to "true" only when the app and the API are served from ONE origin behind a proxy. It keeps
# the session cookie at SameSite=Strict. Leave empty for a split deployment (static bundle on one
# host, API on another), where the cookie must relax to SameSite=None or it is never sent and every
# write fails as unauthenticated. See the deployment section of the README.
COVENANT_SAME_ORIGIN=
# Read-only monitor (npm run dashboard). Mounts no write routes and holds no keys.
DASHBOARD_PORT=4319

# ---- Keeper and settlement store (D15) ----
# The keeper watches the vault for releases and pays them. It runs inside the API process, and only
# when asked: it needs Circle credentials and it moves funds.
COVENANT_KEEPER=
# Where the keeper's scan cursor lives. Any persistent directory. Defaults to ./.state.
COVENANT_STATE_DIR=
#
# Postgres holding settlement records, keyed on (vault, policy id, period). Required for the keeper,
# which will not start without it: the JSON store it replaced keyed settlements without the vault,
# so a policy on a new deployment could be mistaken for an already-paid one and silently skipped.
#
# Prefer the direct (non-pooling) connection string for a long-running keeper. A pooled one works,
# because the store avoids session state, but it is built for short-lived serverless functions.
# Use a separate database for mainnet: testnet experiments and real receipts must not share one.
DATABASE_URL=
#
# ---- Reconciliation and alerts ----
# The keeper keeps a ledger of every release the vault has emitted and compares it with what was
# settled, every five minutes. A release left unpaid, a settlement stuck or failed, and the keeper
# falling behind the chain are each announced once, and again when they clear.
#
# Where the ledger's history starts: the block the current vault was deployed in. Without it the
# ledger only covers releases from the moment the keeper starts, and misses anything released while
# no keeper ran, which is the case it exists for. v4 on Arc testnet was deployed in block 56094189.
POLICY_VAULT_V4_DEPLOY_BLOCK=
# RPC for scanning the vault's history. Falls back to ARC_TESTNET_RPC_FALLBACK_URL, then the main
# RPC. drpc's free plan serves about 100 blocks per log query, Arc's own RPC 10,000.
ARC_LOGS_RPC_URL=
# Telegram, for alerts. Create a bot with @BotFather, send it a message, then find the chat id with
# the bot's getUpdates. The token is a credential: it is never logged, and never sent anywhere but
# Telegram. Without both values, alerts go to the log only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
#
# ---- v5, the non-custodial vault ----
# Users fund their own policies and the vault pays recipients itself; the server never writes to
# it. The keeper's only job is to call release when a policy is releasable, paying the gas, and the
# monitor alerts on releases nobody made, deadlines drawing near, and cross-chain mints Circle has
# not completed. Both run in the API process when COVENANT_KEEPER is on.
POLICY_VAULT_V5_ADDRESS=
POLICY_VAULT_V5_DEPLOY_BLOCK=
# A key of its own, holding a little USDC for gas and nothing else: releasing needs no authority.
V5_KEEPER_PRIVATE_KEY=
# Deploy settings, read by contracts/script/DeployPolicyVaultV5.s.sol. On mainnet the guardian must
# be a multisig contract; the script refuses a plain wallet there.
ARC_CCTP_TOKEN_MESSENGER=
V5_DESTINATIONS=
V5_GUARDIAN=
V5_FUNDS_CAP=
# The same settings for Arc mainnet (chain 5042). On mainnet the deploy script reads only these, so
# no testnet value can be used there by accident; a missing one stops the deploy. The deployer is a
# fresh key, never the testnet one. Mainnet CCTP TokenMessengerV2: 0x28b5a0e9C621a5BadaA536219b3a228C8168cf5d.
MAINNET_DEPLOYER_PRIVATE_KEY=
MAINNET_ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
MAINNET_ARC_CCTP_TOKEN_MESSENGER=
MAINNET_V5_DESTINATIONS=
MAINNET_V5_GUARDIAN=
MAINNET_V5_FUNDS_CAP=
#
# For the test suite only, and never read by anything else. Each run creates and drops its own
# schema. Unset locally, the database tests skip; in CI a missing value fails the build.
TEST_DATABASE_URL=

# ---- Circle Gateway funding (Phase 2.2, VERIFICATIONS V23) ----
# Fund an Arc policy from a unified USDC balance sourced on another chain (Base Sepolia), no bridge.
# GATEWAY_DEPOSITOR_* is the treasury's wallet on the source chain (Base Sepolia).
# DELEGATE_PRIVATE_KEY is a DEDICATED key that can spend the whole unified balance: never the
# deployer (D11). Generate and authorize it with `npm run gateway:authorize`.
GATEWAY_DEPOSITOR_WALLET_ID=
GATEWAY_DEPOSITOR_ADDRESS=
DELEGATE_PRIVATE_KEY=

# ---- Circle Console credentials (VERIFICATIONS.md V7) ----
# kitKey is optional but recommended, it lifts App Kit rate limits.
CIRCLE_KIT_KEY=
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# Unused. PolicyVault is deployed with Foundry, not the Smart Contract Platform (DECISIONS.md D3).
# Kept only for a possible future SCP monitoring integration, which would not require redeploying.
CIRCLE_SCP_API_KEY=

# ---- Wallet ids and addresses ----
# Populated by: node --env-file=.env executor/scripts/create-wallets.mjs --write
# Five wallets, not three. Bridge and payout are separate legs (DECISIONS.md D1), so the executor
# needs a wallet on the destination chain too. The _DEST pair lives on Base Sepolia.
# One wallet set per chain is deliberate, see VERIFICATIONS.md V13 before changing it.
TREASURY_WALLET_ID=
EXECUTOR_WALLET_ID=
RECIPIENT_WALLET_ID=
TREASURY_WALLET_ADDRESS=
EXECUTOR_WALLET_ADDRESS=
RECIPIENT_WALLET_ADDRESS=
EXECUTOR_DEST_WALLET_ID=
RECIPIENT_DEST_WALLET_ID=
EXECUTOR_DEST_WALLET_ADDRESS=
RECIPIENT_DEST_WALLET_ADDRESS=

# ---- Destination chain (VERIFICATIONS.md V4) ----
# App Kit chain identifiers are case sensitive.
DESTINATION_CHAIN=Base_Sepolia
DESTINATION_CCTP_DOMAIN=6
ARC_CCTP_DOMAIN=26
