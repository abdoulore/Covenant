{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:mainnet",
  "outputDirectory": "dist-mainnet",
  "framework": null,
  "rewrites": [
    {
      "source": "/rpc",
      "destination": "https://rpc.mainnet.arc.io/"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    }
  ]
}
