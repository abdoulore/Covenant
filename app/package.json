{
  "name": "@covenant/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Covenant product app: operate the treasury engine from the browser. Static SPA, talks only to the Covenant API.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run check:secrets",
    "check:secrets": "node scripts/check-bundle-secrets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.2"
  }
}
